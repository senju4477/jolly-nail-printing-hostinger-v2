# Preview defaults. Replace SITE_URL with the separate preview app's actual URL.
# Use the intended production HTTPS origin only for a separately authorized launch.
SITE_URL=https://replace-with-your-preview-domain.example
SITE_INDEXABLE=false
HOSTNAME=0.0.0.0
# PORT is provided by Hostinger. Omit it in hPanel; npm start defaults to 3000 locally.

# Optional for a pages-only preview; all four required before enquiries can save.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional TLS for a database whose provider requires an encrypted connection.
# DB_SSL=true uses system trust. DB_SSL_CA accepts the provider's actual PEM CA.
DB_SSL=false
DB_SSL_CA=
